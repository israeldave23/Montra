<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true" android:background="@color/lumen_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding" android:paddingTop="@dimen/space_24">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/goal_title" style="@style/MontraSectionHeading" android:layout_width="0dp" android:layout_weight="1" android:textSize="@dimen/headline_size" android:text="@string/montra_plan" />
            <ImageButton android:id="@+id/plan_add" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target" android:background="@drawable/montra_soft" android:src="@drawable/ic_montra_plus" android:contentDescription="@string/new_goal" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12">
            <Button android:id="@+id/plan_budgets" style="@style/MontraCompactAction" android:text="@string/budget_title" />
            <Button android:id="@+id/plan_goals" style="@style/MontraCompactAction" android:layout_marginStart="@dimen/space_8" android:text="@string/goals_title" />
        </LinearLayout>
        <TextView android:id="@+id/goal_subtitle" style="@style/MontraMonthLabel" android:layout_marginTop="@dimen/space_12" />
        <TextView android:id="@+id/planning_empty" style="@style/MontraEmptyState" android:layout_marginTop="@dimen/space_12" android:visibility="gone" android:text="@string/montra_no_goals" />
    </LinearLayout>
    <ListView android:id="@+id/goals_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:paddingStart="@dimen/space_16" android:paddingEnd="@dimen/space_16" android:paddingTop="@dimen/space_8" />
    <Button android:id="@+id/goal_action" style="@style/MontraPrimaryAction" android:layout_marginStart="@dimen/screen_h_padding" android:layout_marginEnd="@dimen/screen_h_padding" android:layout_marginBottom="@dimen/space_12" android:text="@string/new_goal" />
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
