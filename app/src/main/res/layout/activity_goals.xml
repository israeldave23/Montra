<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_padding"
        android:paddingTop="@dimen/space_32"
        android:paddingEnd="@dimen/screen_h_padding">

        <TextView android:textAppearance="@style/TextAppearance.App.Headline"
            android:id="@+id/goal_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/m3_on_surface" />

        <TextView android:textAppearance="@style/TextAppearance.App.Body"
            android:id="@+id/goal_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/m3_on_surface_variant" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/goal_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_h_padding"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginEnd="@dimen/screen_h_padding"
        android:background="@drawable/action_tile_background"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView android:textAppearance="@style/TextAppearance.App.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/goal_summary_saved"
            android:textColor="@color/m3_on_surface_variant" />

        <TextView android:textAppearance="@style/TextAppearance.App.Headline"
            android:id="@+id/goal_summary_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textColor="@color/m3_on_surface" />

        <TextView android:textAppearance="@style/TextAppearance.App.Meta"
            android:id="@+id/goal_summary_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textColor="@color/m3_on_surface_variant" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_16"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/goal_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_h_padding"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_h_padding"
            android:paddingBottom="@dimen/space_8" />

        <LinearLayout
            android:id="@+id/goal_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_h_padding"
            android:paddingEnd="@dimen/screen_h_padding"
            android:visibility="gone">

            <TextView android:textAppearance="@style/TextAppearance.App.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/goals_body"
                android:textColor="@color/m3_on_surface_variant" />

            <TextView android:textAppearance="@style/TextAppearance.App.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:text="@string/goal_tracking_note"
                android:textColor="@color/m3_on_surface_variant" />
        </LinearLayout>
    </FrameLayout>

    <Button android:textAppearance="@style/TextAppearance.App.Label"
        android:id="@+id/goal_action"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target"
        android:layout_marginStart="@dimen/screen_h_padding"
        android:layout_marginEnd="@dimen/screen_h_padding"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_16"
        android:background="@drawable/primary_button_ripple"
        android:text="@string/new_goal"
        android:textAllCaps="false"
        android:textColor="@color/m3_on_primary" />

    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
