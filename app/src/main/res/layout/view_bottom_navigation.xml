<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_navigation"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/lumen_surface"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">
    <TextView android:id="@+id/nav_home" style="@style/BottomNavigationItem" android:text="@string/home" />
    <TextView android:id="@+id/nav_activity" style="@style/BottomNavigationItem" android:text="@string/activity" />
    <TextView android:id="@+id/nav_budget" style="@style/BottomNavigationItem" android:text="@string/budget" />
    <TextView android:id="@+id/nav_goals" style="@style/BottomNavigationItem" android:text="@string/goals" />
    <TextView android:id="@+id/nav_insights" style="@style/BottomNavigationItem" android:text="@string/insights" />
</LinearLayout>
