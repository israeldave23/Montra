<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp">
    <Spinner android:id="@+id/transaction_account" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Spinner android:id="@+id/transaction_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
    <EditText android:id="@+id/transaction_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/transaction_amount" android:inputType="numberDecimal" />
    <EditText android:id="@+id/transaction_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/transaction_note" android:inputType="text" />
</LinearLayout>
