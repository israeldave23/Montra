<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/action_tile_background" android:orientation="vertical" android:padding="@dimen/space_24">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/transaction_account" android:textColor="@color/lumen_muted" android:textSize="@dimen/text_12" />
    <Spinner android:id="@+id/transaction_account" android:layout_width="match_parent" android:layout_height="48dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:text="@string/transaction_type" android:textColor="@color/lumen_muted" android:textSize="@dimen/text_12" />
    <Spinner android:id="@+id/transaction_type" android:layout_width="match_parent" android:layout_height="48dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:text="@string/transaction_category" android:textColor="@color/lumen_muted" android:textSize="@dimen/text_12" />
    <Spinner android:id="@+id/transaction_category" android:layout_width="match_parent" android:layout_height="48dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:text="@string/transaction_date" android:textColor="@color/lumen_muted" android:textSize="@dimen/text_12" />
    <Button android:id="@+id/transaction_date_picker" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/action_tile_background" android:gravity="start|center_vertical" android:paddingStart="@dimen/space_16" android:paddingEnd="@dimen/space_16" android:textColor="@color/lumen_ink" android:textSize="@dimen/text_14" android:textStyle="normal" />
    <EditText android:id="@+id/transaction_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:hint="@string/transaction_amount" android:inputType="numberDecimal" android:singleLine="true" />
    <EditText android:id="@+id/transaction_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:hint="@string/transaction_note" android:inputType="text" android:singleLine="true" />
</LinearLayout>
