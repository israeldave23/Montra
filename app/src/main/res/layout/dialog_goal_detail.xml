<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/action_tile_background"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/goal_detail_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/lumen_ink"
            android:textSize="@dimen/text_20"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/goal_detail_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:background="@drawable/goal_pill_background"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_4"
            android:textSize="@dimen/text_12"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/goal_detail_amounts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:textColor="@color/lumen_ink"
        android:textSize="@dimen/text_16" />

    <ProgressBar
        android:id="@+id/goal_detail_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="@dimen/space_12"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/goal_detail_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:textColor="@color/lumen_muted"
        android:textSize="@dimen/text_12" />

    <TextView
        android:id="@+id/goal_detail_plan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:textColor="@color/lumen_muted"
        android:textSize="@dimen/text_12"
        android:visibility="gone" />

    <Button
        android:id="@+id/goal_detail_add_funds"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/primary_button_ripple"
        android:text="@string/add_funds"
        android:textAllCaps="false"
        android:textColor="@color/on_primary"
        android:textSize="@dimen/text_14"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/goal_detail_withdraw"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/goal_withdraw"
            android:textColor="@color/lumen_accent"
            android:textSize="@dimen/text_14" />

        <TextView
            android:id="@+id/goal_detail_edit"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/edit"
            android:textColor="@color/lumen_accent"
            android:textSize="@dimen/text_14" />

        <TextView
            android:id="@+id/goal_detail_delete"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/delete"
            android:textColor="@color/lumen_error"
            android:textSize="@dimen/text_14" />
    </LinearLayout>
</LinearLayout>
