<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/action_tile_background" android:orientation="vertical" android:padding="@dimen/space_24">
    <TextView android:textAppearance="@style/TextAppearance.App.Meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/transfer_from" android:textColor="@color/m3_on_surface_variant" />
    <Spinner android:id="@+id/transfer_from_account" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" />
    <TextView android:textAppearance="@style/TextAppearance.App.Meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:text="@string/transfer_to" android:textColor="@color/m3_on_surface_variant" />
    <Spinner android:id="@+id/transfer_to_account" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" />
    <EditText android:id="@+id/transfer_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:hint="@string/transfer_amount" android:inputType="numberDecimal" android:singleLine="true" />
    <EditText android:id="@+id/transfer_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:hint="@string/transfer_note" android:inputType="text" android:singleLine="true" />
</LinearLayout>
