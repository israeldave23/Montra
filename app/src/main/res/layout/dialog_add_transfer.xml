<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/action_tile_background" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/transfer_from" android:textColor="@color/lumen_muted" android:textSize="12sp" />
    <Spinner android:id="@+id/transfer_from_account" android:layout_width="match_parent" android:layout_height="48dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/transfer_to" android:textColor="@color/lumen_muted" android:textSize="12sp" />
    <Spinner android:id="@+id/transfer_to_account" android:layout_width="match_parent" android:layout_height="48dp" />
    <EditText android:id="@+id/transfer_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/transfer_amount" android:inputType="numberDecimal" android:singleLine="true" />
    <EditText android:id="@+id/transfer_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/transfer_note" android:inputType="text" android:singleLine="true" />
</LinearLayout>
