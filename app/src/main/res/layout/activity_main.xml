<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/lumen_background" android:fitsSystemWindows="true" android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false" android:clipToPadding="false" android:scrollbars="none">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:paddingBottom="@dimen/space_24">
       <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding" android:paddingTop="@dimen/space_24">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/greeting" android:textColor="@color/lumen_muted" android:textSize="@dimen/text_12" />
            <TextView android:id="@+id/greeting_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="@string/overview" android:textColor="@color/lumen_ink" android:textSize="@dimen/text_24" android:textStyle="bold" />
        </LinearLayout>
        <FrameLayout android:id="@+id/avatar_container" android:layout_width="48dp" android:layout_height="48dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/profile_title" android:foreground="?android:attr/selectableItemBackgroundBorderless"><TextView android:id="@+id/avatar" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/avatar_background" android:gravity="center" android:text="L" android:textColor="@color/on_primary" android:textSize="@dimen/text_20" android:textStyle="bold" /><ImageView android:id="@+id/avatar_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" /></FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:background="@drawable/balance_card_background" android:elevation="0dp" android:orientation="vertical" android:padding="@dimen/space_24" android:layout_marginStart="@dimen/screen_h_padding" android:layout_marginEnd="@dimen/screen_h_padding">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/total_balance" android:textAllCaps="false" android:textColor="@color/on_balance" android:textSize="@dimen/text_14" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/balance" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textColor="@color/on_balance" android:textSize="@dimen/text_36" android:textStyle="bold" />
            <ImageButton android:id="@+id/toggle_balance" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/hide_balance" android:src="@drawable/ic_visibility" />
        </LinearLayout>
        <TextView android:id="@+id/balance_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="@string/empty_balance" android:textColor="@color/on_balance" android:textSize="@dimen/text_14" />
        <Button android:id="@+id/add_account_button" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_16" android:background="@drawable/hero_button_ripple" android:text="@string/add_account" android:textAllCaps="false" android:textColor="@color/on_balance" android:textSize="@dimen/text_14" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/home_accounts_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding" android:layout_marginTop="@dimen/space_24">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/accounts_title" android:textColor="@color/lumen_ink" android:textSize="@dimen/text_18" android:textStyle="bold" />
            <TextView android:id="@+id/home_accounts_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lumen_muted" android:textSize="@dimen/text_12" />
        </LinearLayout>
        <LinearLayout android:id="@+id/home_accounts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:orientation="vertical" />
    </LinearLayout>
    <TextView android:id="@+id/home_accounts_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/screen_h_padding" android:layout_marginEnd="@dimen/screen_h_padding" android:layout_marginTop="@dimen/space_24" android:background="@drawable/action_tile_background" android:padding="@dimen/space_16" android:text="@string/home_accounts_empty" android:textColor="@color/lumen_muted" android:textSize="@dimen/text_14" android:visibility="gone" />
    <TextView android:id="@+id/monthly_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/screen_h_padding" android:layout_marginEnd="@dimen/screen_h_padding" android:layout_marginTop="@dimen/space_24" android:textColor="@color/lumen_ink" android:textSize="@dimen/text_14" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding" android:layout_marginTop="@dimen/space_24">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/quick_actions" android:textColor="@color/lumen_ink" android:textSize="@dimen/text_18" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/add_transaction_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="@dimen/space_8" android:background="@drawable/action_tile_ripple" android:elevation="0dp" android:orientation="vertical" android:padding="@dimen/space_16">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/icon_badge_background" android:contentDescription="@null" android:importantForAccessibility="no" android:padding="@dimen/space_8" android:src="@drawable/ic_action_add" android:tint="@color/m3_on_secondary_container" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:text="@string/add_transaction" android:textColor="@color/lumen_ink" android:textSize="@dimen/text_14" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/add_transfer_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/space_8" android:background="@drawable/action_tile_ripple" android:elevation="0dp" android:orientation="vertical" android:padding="@dimen/space_16">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/icon_badge_accent_background" android:contentDescription="@null" android:importantForAccessibility="no" android:padding="@dimen/space_8" android:src="@drawable/ic_cat_transfer" android:tint="@color/m3_on_tertiary_container" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:text="@string/add_transfer" android:textColor="@color/lumen_ink" android:textSize="@dimen/text_14" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_32" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/recent_activity" android:textColor="@color/lumen_ink" android:textSize="@dimen/text_18" android:textStyle="bold" />
                    <Button android:id="@+id/view_activity_button" android:layout_width="wrap_content" android:layout_height="@dimen/touch_target" android:background="@android:color/transparent" android:text="@string/see_all" android:textAllCaps="false" android:textColor="@color/lumen_accent" android:textSize="@dimen/text_14" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/recent_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:background="@drawable/action_tile_background" android:padding="@dimen/space_16" android:text="@string/recent_activity_empty" android:textColor="@color/lumen_muted" android:textSize="@dimen/text_14" />
                <LinearLayout android:id="@+id/recent_transactions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:orientation="vertical" />
            </LinearLayout>
       </LinearLayout>
      </LinearLayout>
      </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
