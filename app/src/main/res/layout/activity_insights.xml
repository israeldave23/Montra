<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true" android:background="@color/lumen_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding" android:paddingTop="@dimen/space_24">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView style="@style/MontraSectionHeading" android:layout_width="0dp" android:layout_weight="1" android:text="@string/insights_title" android:textSize="@dimen/headline_size" />
            <ImageButton android:id="@+id/insights_activity" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target" android:background="@drawable/montra_soft" android:src="@drawable/ic_montra_activity" android:contentDescription="@string/nav_activity_description" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="@dimen/space_12">
            <TextView android:id="@+id/insights_month" style="@style/MontraMonthLabel" />
            <Button android:id="@+id/insights_currency" style="@style/MontraCompactAction" android:layout_marginStart="@dimen/space_8" />
        </LinearLayout>
        <include layout="@layout/view_monthly_totals" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:padding="@dimen/space_16" android:background="@drawable/action_tile_background" android:orientation="vertical">
            <TextView style="@style/MontraFormLabel" android:text="@string/montra_net_cash_flow" />
            <TextView android:id="@+id/insights_net" style="@style/MontraSectionHeading" android:layout_width="match_parent" android:layout_marginTop="@dimen/space_4" android:textSize="@dimen/headline_size" android:fontFeatureSettings="tnum" />
        </LinearLayout>
        <TextView style="@style/MontraSectionHeading" android:layout_marginTop="@dimen/space_12" android:text="@string/montra_spending_by_category" />
        <TextView android:id="@+id/insights_empty" style="@style/MontraEmptyState" android:layout_marginTop="@dimen/space_12" android:text="@string/montra_no_spending" android:visibility="gone" />
    </LinearLayout>
    <ListView android:id="@+id/insights_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:paddingStart="@dimen/space_16" android:paddingEnd="@dimen/space_16" android:paddingTop="@dimen/space_8" />
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
