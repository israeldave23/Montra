<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumen_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_padding"
        android:paddingTop="@dimen/space_32"
        android:paddingEnd="@dimen/screen_h_padding">

        <TextView
            android:id="@+id/insights_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/lumen_ink"
            android:textSize="@dimen/text_24"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/insights_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/lumen_muted"
            android:textSize="@dimen/text_14" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_h_padding"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginEnd="@dimen/screen_h_padding"
        android:background="@drawable/action_tile_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8">

        <TextView
            android:id="@+id/insights_month_prev"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/insights_previous_month"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/lumen_accent"
            android:textSize="@dimen/text_24" />

        <TextView
            android:id="@+id/insights_month_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/lumen_ink"
            android:textSize="@dimen/text_16"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/insights_month_next"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/insights_next_month"
            android:focusable="true"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/lumen_accent"
            android:textSize="@dimen/text_24" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_12"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/insights_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_h_padding"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_h_padding"
            android:paddingBottom="@dimen/space_16" />

        <LinearLayout
            android:id="@+id/insights_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_h_padding"
            android:paddingEnd="@dimen/screen_h_padding"
            android:visibility="gone">

            <TextView
                android:id="@+id/insights_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/lumen_muted"
                android:textSize="@dimen/text_14" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:text="@string/insights_empty_hint"
                android:textColor="@color/lumen_muted"
                android:textSize="@dimen/text_12" />
        </LinearLayout>
    </FrameLayout>

    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
