<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    android:background="@drawable/balance_surface_background"
    android:orientation="vertical"
    android:padding="@dimen/space_16">

    <TextView android:textAppearance="@style/TextAppearance.App.LabelSmall"
        android:id="@+id/insight_summary_currency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/m3_on_surface_variant" />

    <TextView android:textAppearance="@style/TextAppearance.App.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/insights_expenses_label"
        android:textColor="@color/m3_on_surface_variant" />

    <TextView android:textAppearance="@style/TextAppearance.App.Headline"
        android:id="@+id/insight_summary_expense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:textColor="@color/m3_on_surface" />

    <TextView android:textAppearance="@style/TextAppearance.App.Body"
        android:id="@+id/insight_summary_flow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:textColor="@color/m3_on_surface" />

    <TextView android:textAppearance="@style/TextAppearance.App.Meta"
        android:id="@+id/insight_summary_change"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:textColor="@color/m3_on_surface_variant" />

    <TextView android:textAppearance="@style/TextAppearance.App.Meta"
        android:id="@+id/insight_summary_average"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:textColor="@color/m3_on_surface_variant" />

    <TextView android:textAppearance="@style/TextAppearance.App.LabelSmall"
        android:id="@+id/insight_summary_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:textColor="@color/m3_primary" />
</LinearLayout>
