<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/action_tile_background"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/goal_tracking_note"
            android:textColor="@color/lumen_muted"
            android:textSize="@dimen/text_12" />

        <EditText
            android:id="@+id/goal_edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:hint="@string/goal_name"
            android:inputType="textPersonName"
            android:maxLength="100"
            android:singleLine="true" />

        <EditText
            android:id="@+id/goal_edit_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <LinearLayout
            android:id="@+id/goal_edit_saved_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/goal_edit_saved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:inputType="numberDecimal"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/goal_target_date"
            android:textColor="@color/lumen_muted"
            android:textSize="@dimen/text_12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/goal_edit_date"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target"
                android:layout_weight="1"
                android:background="@drawable/action_tile_background"
                android:gravity="start|center_vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:textAllCaps="false"
                android:textColor="@color/lumen_ink"
                android:textSize="@dimen/text_14" />

            <TextView
                android:id="@+id/goal_edit_clear_date"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:text="@string/goal_clear_date"
                android:textColor="@color/lumen_accent"
                android:textSize="@dimen/text_14"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
