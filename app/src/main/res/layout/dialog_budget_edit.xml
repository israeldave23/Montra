<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/action_tile_background"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/budget_edit_hint"
            android:textColor="@color/lumen_muted"
            android:textSize="@dimen/text_12" />

        <TextView
            android:id="@+id/budget_edit_category_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/budget_category_label"
            android:textColor="@color/lumen_muted"
            android:textSize="@dimen/text_12" />

        <Spinner
            android:id="@+id/budget_edit_category"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_4"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12" />

        <EditText
            android:id="@+id/budget_edit_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <TextView
            android:id="@+id/budget_edit_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:textColor="@color/lumen_muted"
            android:textSize="@dimen/text_12" />
    </LinearLayout>
</ScrollView>
