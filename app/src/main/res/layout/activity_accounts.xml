<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:orientation="vertical" android:background="@color/lumen_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding" android:paddingTop="@dimen/space_24">
        <ImageButton android:id="@+id/accounts_back" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target" android:background="@drawable/montra_soft" android:src="@drawable/ic_montra_back" android:contentDescription="@string/back" />
        <TextView style="@style/MontraSectionHeading" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="@dimen/space_12" android:text="@string/montra_accounts" android:textSize="@dimen/headline_size" />
        <ImageButton android:id="@+id/accounts_add_shortcut" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target" android:background="@drawable/montra_soft" android:src="@drawable/ic_montra_plus" android:contentDescription="@string/add_account" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding" android:paddingTop="@dimen/space_16" android:paddingBottom="@dimen/space_24">
            <TextView android:id="@+id/accounts_empty" style="@style/MontraEmptyState" android:visibility="gone" android:text="@string/montra_accounts_empty" />
            <LinearLayout android:id="@+id/accounts_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <Button android:id="@+id/accounts_add" style="@style/MontraPrimaryAction" android:layout_marginTop="@dimen/space_12" android:text="@string/add_account" android:drawableStart="@drawable/ic_montra_plus" />
            <Button android:id="@+id/accounts_transfer" style="@style/MontraCompactAction" android:layout_marginTop="@dimen/space_12" android:text="@string/add_transfer" android:drawableStart="@drawable/ic_montra_transfer" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
