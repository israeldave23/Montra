<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding" android:paddingTop="@dimen/space_8" android:paddingBottom="@dimen/space_24">
    <TextView android:id="@+id/plan_form_currency" style="@style/MontraMonthLabel" />
    <TextView style="@style/MontraFormLabel" android:layout_marginTop="@dimen/space_12" android:text="@string/goal_name" android:labelFor="@id/plan_goal_name" />
    <EditText android:id="@+id/plan_goal_name" style="@style/MontraFormField" android:layout_marginTop="@dimen/space_4" android:inputType="textCapSentences" android:singleLine="true" />
    <TextView style="@style/MontraFormLabel" android:layout_marginTop="@dimen/space_12" android:text="@string/target_amount" android:labelFor="@id/plan_amount" />
    <EditText android:id="@+id/plan_amount" style="@style/MontraFormField" android:layout_marginTop="@dimen/space_4" android:inputType="numberDecimal" android:singleLine="true" />
    <TextView style="@style/MontraFormLabel" android:layout_marginTop="@dimen/space_12" android:text="@string/saved_amount" android:labelFor="@id/plan_already_saved" />
    <EditText android:id="@+id/plan_already_saved" style="@style/MontraFormField" android:layout_marginTop="@dimen/space_4" android:inputType="numberDecimal" android:singleLine="true" />
</LinearLayout>
