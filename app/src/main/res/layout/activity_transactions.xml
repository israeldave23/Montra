<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/m3_background" android:fitsSystemWindows="true" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding" android:paddingTop="@dimen/space_24" android:paddingBottom="@dimen/space_12">
        <ImageView
            android:id="@+id/transactions_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/action_tile_background"
            android:contentDescription="@string/back"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"
            style="@style/Widget.App.Icon" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="@dimen/space_16">
            <TextView android:textAppearance="@style/TextAppearance.App.Headline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_title" android:textColor="@color/m3_on_surface" />
            <TextView android:textAppearance="@style/TextAppearance.App.Meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="@string/activity_subtitle" android:textColor="@color/m3_on_surface_variant" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding" android:paddingBottom="@dimen/space_16">
        <EditText android:textAppearance="@style/TextAppearance.App.Body" android:id="@+id/transaction_search" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:background="@drawable/search_field_background" android:hint="@string/search_transactions" android:inputType="text" android:paddingStart="@dimen/space_16" android:paddingEnd="@dimen/space_16" android:singleLine="true" android:textColor="@color/m3_on_surface" android:textColorHint="@color/m3_on_surface_variant" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/transaction_filters" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/filter_all" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/filter_all" />
            <com.google.android.material.chip.Chip android:id="@+id/filter_income" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_income" />
            <com.google.android.material.chip.Chip android:id="@+id/filter_expense" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_expense" />
            <com.google.android.material.chip.Chip android:id="@+id/filter_transfer" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_transfer" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding" android:paddingBottom="@dimen/space_8">
        <TextView android:textAppearance="@style/TextAppearance.App.Body" android:id="@+id/transaction_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/action_tile_background" android:padding="@dimen/space_24" android:text="@string/empty_transactions" android:textColor="@color/m3_on_surface_variant" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/transaction_list" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="@dimen/space_12" />
    </LinearLayout>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
