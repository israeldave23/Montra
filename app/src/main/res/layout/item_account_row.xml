<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_8"
    android:background="@drawable/action_tile_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_16">

    <TextView android:textAppearance="@style/TextAppearance.App.Initial"
        android:id="@+id/account_row_initial"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:layout_marginEnd="@dimen/space_12"
        android:background="@drawable/avatar_background"
        android:gravity="center"
        android:textColor="@color/m3_on_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:textAppearance="@style/TextAppearance.App.Subtitle"
                android:id="@+id/account_row_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/m3_on_surface" />

            <TextView android:textAppearance="@style/TextAppearance.App.LabelSmall"
                android:id="@+id/account_row_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/goal_pill_background"
                android:backgroundTint="@color/m3_on_surface_variant"
                android:paddingStart="@dimen/space_8"
                android:paddingTop="@dimen/space_4"
                android:paddingEnd="@dimen/space_8"
                android:paddingBottom="@dimen/space_4"
                android:text="@string/account_archived"
                android:textColor="@color/m3_on_primary"
                android:visibility="gone" />
        </LinearLayout>

        <TextView android:textAppearance="@style/TextAppearance.App.Meta"
            android:id="@+id/account_row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/m3_on_surface_variant" />
    </LinearLayout>

    <TextView android:textAppearance="@style/TextAppearance.App.Subtitle"
        android:id="@+id/account_row_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:gravity="end"
        android:textColor="@color/m3_on_surface" />
</LinearLayout>
