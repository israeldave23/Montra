<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    android:background="@drawable/action_tile_ripple"
    android:elevation="0dp"
    android:orientation="horizontal"
    android:padding="@dimen/space_16"
    android:gravity="center_vertical">
    <ImageView
        android:id="@+id/insight_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="@dimen/space_12"
        android:background="@drawable/avatar_background"
        android:padding="@dimen/space_12"
        android:contentDescription="@null" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/insight_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/lumen_ink"
                android:textSize="@dimen/text_16"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/insight_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lumen_ink"
                android:textSize="@dimen/text_14"
                android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/insight_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="@dimen/space_8"
            android:progressDrawable="@drawable/progress_bar_rounded"
            android:max="100"
            android:progress="0" />
        <TextView android:id="@+id/insight_share" style="@style/MontraFormLabel" android:layout_marginTop="@dimen/space_4" />
    </LinearLayout>
</LinearLayout>
