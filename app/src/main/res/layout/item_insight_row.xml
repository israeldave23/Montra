<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    android:background="@drawable/action_tile_background"
    android:orientation="horizontal"
    android:padding="@dimen/space_16">

    <ImageView
        android:id="@+id/insight_row_icon"
        android:layout_width="@dimen/icon_badge_size"
        android:layout_height="@dimen/icon_badge_size"
        android:layout_marginEnd="@dimen/space_12"
        android:background="@drawable/icon_badge_background"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="@dimen/space_8"
        style="@style/Widget.App.Icon.OnBadge" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:textAppearance="@style/TextAppearance.App.Subtitle"
                android:id="@+id/insight_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/m3_on_surface" />

            <TextView android:textAppearance="@style/TextAppearance.App.Body"
                android:id="@+id/insight_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:textColor="@color/m3_on_surface" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/insight_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_thickness"
            android:layout_marginTop="@dimen/space_8"
            android:max="100"
            android:progress="0" />

        <TextView android:textAppearance="@style/TextAppearance.App.Meta"
            android:id="@+id/insight_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textColor="@color/m3_on_surface_variant" />
    </LinearLayout>
</LinearLayout>
