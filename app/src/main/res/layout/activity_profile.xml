<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/lumen_background" android:fitsSystemWindows="true" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding" android:paddingTop="20dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/profile_back" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/action_tile_background" android:contentDescription="@string/back" android:gravity="center" android:text="‹" android:textSize="30sp" android:textColor="@color/lumen_ink" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/profile_title" android:textColor="@color/lumen_ink" android:textSize="28sp" android:textStyle="bold" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding">
        <TextView android:id="@+id/profile_avatar" android:layout_width="92dp" android:layout_height="92dp" android:layout_marginTop="22dp" android:background="@drawable/avatar_background" android:gravity="center" android:textColor="@color/on_primary" android:textSize="32sp" android:textStyle="bold" />
        <TextView android:id="@+id/profile_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/lumen_ink" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/profile_local_only" android:textColor="@color/lumen_muted" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:background="@drawable/action_tile_background" android:elevation="2dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_display_name" android:textColor="@color/lumen_ink" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/profile_name_help" android:textColor="@color/lumen_muted" android:textSize="13sp" />
            </LinearLayout>
            <Button android:id="@+id/profile_edit" android:layout_width="wrap_content" android:layout_height="@dimen/touch_target" android:background="@drawable/primary_button_ripple" android:text="@string/edit" android:textAllCaps="false" android:textColor="@color/on_primary" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
