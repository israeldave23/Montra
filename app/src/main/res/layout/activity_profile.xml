<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/lumen_background" android:fitsSystemWindows="true" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding" android:paddingTop="@dimen/space_24" android:paddingBottom="@dimen/space_8">
        <ImageView android:id="@+id/profile_back" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/action_tile_background" android:contentDescription="@string/back" android:padding="@dimen/space_12" android:src="@drawable/ic_montra_back" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_16" android:text="@string/montra_settings" android:textColor="@color/lumen_ink" android:textSize="@dimen/headline_size" android:textStyle="bold" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:orientation="vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="@dimen/space_12" android:background="@drawable/action_tile_background">
            <TextView android:id="@+id/profile_avatar" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target" android:gravity="center" android:background="@drawable/montra_soft" android:textColor="@color/lumen_ink" android:textStyle="bold" />
            <TextView android:id="@+id/profile_name" style="@style/MontraSectionHeading" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="@dimen/space_12" />
            <Button android:id="@+id/profile_edit" style="@style/MontraCompactAction" android:text="@string/edit" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="@string/profile_local_only" android:textColor="@color/lumen_muted" android:textSize="@dimen/text_12" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:text="@string/montra_preferences" android:textColor="@color/lumen_ink" android:textSize="@dimen/text_18" android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:background="@drawable/action_tile_background" android:elevation="0dp" android:orientation="vertical" android:padding="@dimen/card_padding">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_theme" android:textColor="@color/lumen_ink" android:textSize="@dimen/text_16" android:textStyle="bold" android:layout_marginBottom="@dimen/space_8" />
            <Spinner android:id="@+id/profile_theme" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_16" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_default_currency" android:textColor="@color/lumen_ink" android:textSize="@dimen/text_16" android:textStyle="bold" android:layout_marginBottom="@dimen/space_8" />
            <Spinner android:id="@+id/profile_currency" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_16" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_currency_applies" android:textColor="@color/lumen_muted" android:textSize="@dimen/text_12" android:layout_marginBottom="@dimen/space_16" />
        </LinearLayout>
        <TextView style="@style/MontraSectionHeading" android:text="@string/montra_local_data" android:layout_marginTop="@dimen/space_24" />
        <Button android:id="@+id/profile_export" style="@style/MontraFormField" android:text="@string/profile_export_transactions" android:layout_marginTop="@dimen/space_12" android:gravity="start|center_vertical" android:textAllCaps="false" />
        <Button android:id="@+id/profile_backup" style="@style/MontraFormField" android:text="@string/profile_backup_database" android:layout_marginTop="@dimen/space_12" android:gravity="start|center_vertical" android:textAllCaps="false" />
        <Button android:id="@+id/profile_restore" style="@style/MontraFormField" android:text="@string/profile_restore_database" android:layout_marginTop="@dimen/space_12" android:gravity="start|center_vertical" android:textAllCaps="false" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
