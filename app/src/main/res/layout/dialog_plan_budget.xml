<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding" android:paddingTop="@dimen/space_8" android:paddingBottom="@dimen/space_24">
    <TextView android:id="@+id/plan_form_currency" style="@style/MontraMonthLabel" />
    <TextView style="@style/MontraFormLabel" android:layout_marginTop="@dimen/space_12" android:text="@string/transaction_category" android:labelFor="@id/plan_category" />
    <Spinner android:id="@+id/plan_category" style="@style/MontraFormField" android:layout_marginTop="@dimen/space_4" />
    <TextView style="@style/MontraFormLabel" android:layout_marginTop="@dimen/space_12" android:text="@string/budget_limit" android:labelFor="@id/plan_amount" />
    <EditText android:id="@+id/plan_amount" style="@style/MontraFormField" android:layout_marginTop="@dimen/space_4" android:inputType="numberDecimal" android:singleLine="true" />
</LinearLayout>
