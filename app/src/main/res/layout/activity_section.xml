<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/m3_background" android:fitsSystemWindows="true" android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/screen_h_padding" android:paddingEnd="@dimen/screen_h_padding" android:paddingTop="@dimen/space_32" android:paddingBottom="@dimen/space_32">
        <TextView android:textAppearance="@style/TextAppearance.App.Headline" android:id="@+id/section_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/m3_on_surface" />
        <TextView android:textAppearance="@style/TextAppearance.App.Body" android:id="@+id/section_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:textColor="@color/m3_on_surface_variant" />
        <ImageView android:id="@+id/section_icon" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_24" android:contentDescription="@null" android:src="@drawable/ic_nav_budget" style="@style/Widget.App.Icon" />
        <TextView android:textAppearance="@style/TextAppearance.App.BodyLarge" android:id="@+id/section_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:background="@drawable/action_tile_background" android:padding="@dimen/card_padding" android:textColor="@color/m3_on_surface" />
        <LinearLayout android:id="@+id/insight_categories" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:background="@drawable/action_tile_background" android:orientation="vertical" android:padding="@dimen/card_padding" android:visibility="gone" />
        <Button android:id="@+id/section_action" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_16" android:background="@drawable/primary_button_ripple" android:text="@string/add_transaction" android:textColor="@color/m3_on_primary" android:visibility="gone" />
    </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
