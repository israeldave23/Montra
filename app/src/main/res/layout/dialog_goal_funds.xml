<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/action_tile_background"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <TextView
        android:id="@+id/goal_funds_context"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/m3_on_surface"
        android:textSize="@dimen/text_14" />

    <EditText
        android:id="@+id/goal_funds_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:inputType="numberDecimal"
        android:singleLine="true" />

    <LinearLayout
        android:id="@+id/goal_funds_quick_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/goal_funds_quick_1"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/space_4"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textColor="@color/m3_primary"
            android:textSize="@dimen/text_14"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/goal_funds_quick_2"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="@dimen/space_4"
            android:layout_marginEnd="@dimen/space_4"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textColor="@color/m3_primary"
            android:textSize="@dimen/text_14"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/goal_funds_quick_3"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textColor="@color/m3_primary"
            android:textSize="@dimen/text_14"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/goal_funds_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/m3_on_surface_variant"
        android:textSize="@dimen/text_12" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/add_funds_note"
        android:textColor="@color/m3_on_surface_variant"
        android:textSize="@dimen/text_12" />
</LinearLayout>
