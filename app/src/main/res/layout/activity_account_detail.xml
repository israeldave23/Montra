<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_8"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_8">

        <ImageView
            android:id="@+id/account_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"
            style="@style/Widget.App.Icon" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/account_menu"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/account_more_actions"
            android:focusable="true"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_more_vert"
            android:scaleType="fitCenter"
            style="@style/Widget.App.Icon" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_padding"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/screen_h_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:textAppearance="@style/TextAppearance.App.Headline"
                android:id="@+id/account_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/m3_on_surface" />

            <TextView android:textAppearance="@style/TextAppearance.App.LabelSmall"
                android:id="@+id/account_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/goal_pill_background"
                android:backgroundTint="@color/m3_on_surface_variant"
                android:paddingStart="@dimen/space_8"
                android:paddingTop="@dimen/space_4"
                android:paddingEnd="@dimen/space_8"
                android:paddingBottom="@dimen/space_4"
                android:text="@string/account_archived"
                android:textColor="@color/m3_on_primary"
                android:visibility="gone" />
        </LinearLayout>

        <TextView android:textAppearance="@style/TextAppearance.App.Meta"
            android:id="@+id/account_archived_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/account_archived_hint"
            android:textColor="@color/m3_on_surface_variant"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/account_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_h_padding"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginEnd="@dimen/screen_h_padding"
        android:background="@drawable/balance_card_background"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView android:textAppearance="@style/TextAppearance.App.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/account_balance_label"
            android:textColor="@color/m3_on_hero" />

        <TextView android:textAppearance="@style/TextAppearance.App.Display"
            android:id="@+id/account_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/m3_on_hero" />

        <TextView android:textAppearance="@style/TextAppearance.App.Meta"
            android:id="@+id/account_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/m3_on_hero" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_h_padding"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginEnd="@dimen/screen_h_padding"
        android:orientation="horizontal">

        <Button android:textAppearance="@style/TextAppearance.App.Label"
            android:id="@+id/account_add_transaction"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_weight="1"
            android:background="@drawable/primary_button_ripple"
            android:text="@string/account_add_transaction"
            android:textAllCaps="false"
            android:textColor="@color/m3_on_primary" />

        <Button android:textAppearance="@style/TextAppearance.App.Label"
            android:id="@+id/account_transfer"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:background="@drawable/action_tile_ripple"
            android:text="@string/account_transfer"
            android:textAllCaps="false"
            android:textColor="@color/m3_on_surface" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_h_padding"
        android:layout_marginTop="@dimen/space_24"
        android:layout_marginEnd="@dimen/screen_h_padding"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView android:textAppearance="@style/TextAppearance.App.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/account_activity_title"
            android:textColor="@color/m3_on_surface" />

        <TextView android:textAppearance="@style/TextAppearance.App.Meta"
            android:id="@+id/account_activity_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/m3_on_surface_variant" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/account_transactions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_h_padding"
            android:paddingEnd="@dimen/screen_h_padding"
            android:paddingBottom="@dimen/space_16" />

        <TextView android:textAppearance="@style/TextAppearance.App.Body"
            android:id="@+id/account_activity_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="@dimen/screen_h_padding"
            android:paddingEnd="@dimen/screen_h_padding"
            android:text="@string/account_activity_empty"
            android:textColor="@color/m3_on_surface_variant"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
