<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    android:background="@drawable/action_tile_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="@dimen/space_16">

    <ImageView
        android:id="@+id/budget_row_icon"
        android:layout_width="@dimen/icon_badge_size"
        android:layout_height="@dimen/icon_badge_size"
        android:layout_marginEnd="@dimen/space_12"
        android:background="@drawable/icon_badge_background"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="@dimen/space_8"
        style="@style/Widget.App.Icon.OnBadge" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:textAppearance="@style/TextAppearance.App.Subtitle"
                android:id="@+id/budget_row_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/m3_on_surface" />

            <TextView android:textAppearance="@style/TextAppearance.App.LabelSmall"
                android:id="@+id/budget_row_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/goal_pill_background"
                android:paddingStart="@dimen/space_8"
                android:paddingTop="@dimen/space_4"
                android:paddingEnd="@dimen/space_8"
                android:paddingBottom="@dimen/space_4" />
        </LinearLayout>

        <TextView android:textAppearance="@style/TextAppearance.App.Body"
            android:id="@+id/budget_row_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/m3_on_surface" />

        <ProgressBar
            android:id="@+id/budget_row_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_thickness"
            android:layout_marginTop="@dimen/space_8"
            android:max="100"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:textAppearance="@style/TextAppearance.App.Meta"
                android:id="@+id/budget_row_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/m3_on_surface_variant" />

            <ImageView
                android:id="@+id/budget_row_menu"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/budget_more_actions"
                android:focusable="true"
                android:padding="@dimen/space_12"
                android:src="@drawable/ic_more_vert"
                android:scaleType="fitCenter"
                style="@style/Widget.App.Icon" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
