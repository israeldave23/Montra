<resources>
    <style name="MontraPrimaryAction">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item><item name="android:background">@drawable/primary_button_ripple</item>
        <item name="android:textAllCaps">false</item><item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">@dimen/text_14</item><item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/space_16</item><item name="android:paddingEnd">@dimen/space_16</item>
    </style>
    <style name="MontraCompactAction">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target</item><item name="android:background">@drawable/montra_soft</item>
        <item name="android:textAllCaps">false</item><item name="android:textColor">@color/lumen_ink</item>
        <item name="android:textSize">@dimen/text_14</item><item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/space_12</item><item name="android:paddingEnd">@dimen/space_12</item>
        <item name="android:drawablePadding">@dimen/space_8</item>
    </style>
    <style name="MontraSectionHeading">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/lumen_ink</item><item name="android:textStyle">bold</item><item name="android:textSize">@dimen/text_18</item>
    </style>
    <style name="MontraMonthLabel">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/montra_soft</item><item name="android:padding">@dimen/space_8</item>
        <item name="android:textColor">@color/lumen_ink</item><item name="android:textSize">@dimen/text_12</item>
    </style>
    <style name="MontraEmptyState">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/montra_soft</item><item name="android:padding">@dimen/space_16</item>
        <item name="android:textColor">@color/lumen_muted</item><item name="android:textSize">@dimen/text_14</item>
    </style>
    <style name="MontraEntryDialog" parent="Theme.App">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="MontraFormLabel">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/lumen_muted</item><item name="android:textSize">@dimen/text_12</item>
    </style>
    <style name="MontraFormField">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target</item><item name="android:background">@drawable/search_field_background</item>
        <item name="android:paddingStart">@dimen/space_12</item><item name="android:paddingEnd">@dimen/space_12</item>
        <item name="android:textColor">@color/lumen_ink</item><item name="android:textColorHint">@color/lumen_muted</item>
    </style>
</resources>
