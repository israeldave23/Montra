<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Material 3 colour roles, light scheme.
      Trusted blue is the primary, growth green is the secondary (positive money), warm amber is the
      single accent (tertiary) and everything structural is a neutral with a faint blue cast.
      Values-night/colors.xml overrides every m3_* role for the dark scheme.
    -->
    <color name="m3_primary">#14508C</color>
    <color name="m3_on_primary">#FFFFFF</color>
    <color name="m3_primary_container">#D6E4FF</color>
    <color name="m3_on_primary_container">#001B3D</color>

    <color name="m3_secondary">#1D6B4C</color>
    <color name="m3_on_secondary">#FFFFFF</color>
    <color name="m3_secondary_container">#BCEBD5</color>
    <color name="m3_on_secondary_container">#002114</color>

    <color name="m3_tertiary">#7A5200</color>
    <color name="m3_on_tertiary">#FFFFFF</color>
    <color name="m3_tertiary_container">#FFDFA0</color>
    <color name="m3_on_tertiary_container">#261A00</color>

    <color name="m3_error">#B3261E</color>
    <color name="m3_on_error">#FFFFFF</color>
    <color name="m3_error_container">#F9DEDC</color>
    <color name="m3_on_error_container">#410E0B</color>

    <color name="m3_background">#F4F6FB</color>
    <color name="m3_on_background">#111726</color>
    <color name="m3_surface">#FFFFFF</color>
    <color name="m3_on_surface">#111726</color>
