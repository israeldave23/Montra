<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Material 3 theme with an explicit role map. The UI is plain Views, so the roles are applied by
      referencing these attributes (and the matching colours) from layouts and drawables.
    -->
    <style name="Theme.App" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/m3_background</item>

        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorOnBackground">@color/m3_on_background</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="colorSurfaceInverse">@color/m3_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/m3_inverse_on_surface</item>

        <!-- Legacy attributes still read by platform widgets. -->
        <item name="android:colorPrimary">@color/m3_primary</item>
        <item name="android:colorAccent">@color/m3_primary</item>
        <item name="android:textColorPrimary">@color/m3_on_surface</item>
        <item name="android:textColorSecondary">@color/m3_on_surface_variant</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/m3_background</item>
        <item name="android:navigationBarColor">@color/m3_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowAnimationStyle">@style/AppWindowAnimation</item>
    </style>
    <style name="AppWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/activity_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_exit</item>
        <item name="android:taskOpenEnterAnimation">@anim/activity_enter</item>
        <item name="android:taskOpenExitAnimation">@anim/activity_exit</item>
        <item name="android:taskCloseEnterAnimation">@anim/activity_enter</item>
        <item name="android:taskCloseExitAnimation">@anim/activity_exit</item>
        <item name="android:windowEnterAnimation">@anim/activity_enter</item>
        <item name="android:windowExitAnimation">@anim/activity_exit</item>
    </style>
    <style name="BottomNavigationItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/m3_on_surface_variant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawablePadding">@dimen/space_4</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
