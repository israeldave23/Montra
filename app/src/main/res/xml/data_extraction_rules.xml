<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android 12 and later read when deciding what to back up. android:allowBackup="false" still
  covers 26 to 30; this file makes the same statement to 31+, where that attribute was deprecated and
  lint asks for the replacement.

  Montra's ledger never leaves the device. Both the cloud backup and the device-to-device transfer are
  excluded outright, so the only copy that exists is the one the user exports by hand - which is what
  PRIVACY.md tells them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
