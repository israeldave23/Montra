<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/m3_ripple">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="@color/m3_ripple" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/m3_surface" />
            <stroke android:width="@dimen/stroke_hairline" android:color="@color/m3_outline_variant" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
</ripple>
