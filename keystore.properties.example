# Copy to keystore.properties (git-ignored) to sign release builds locally, or set the same four
# values as CI secrets and write the file in the workflow before assembling.
#
#   keytool -genkeypair -v -keystore montra-release.jks -alias montra \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to the app module, so ../montra-release.jks means the repository root.
storeFile=../montra-release.jks
storePassword=change-me
keyAlias=montra
keyPassword=change-me
